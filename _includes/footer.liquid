{% if site.footer %}
  {% if site.footer_fixed %}
    <footer class="fixed-bottom">
      <div class="container mt-0">
        <div>{{ site.footer_text }}</div>
      </div>
    </footer>
  {% else %}
    <footer class="sticky-bottom mt-5">
      <div class="container text-center">
        <div>{{ site.footer_text }}</div>
      </div>
    </footer>
  {% endif %}
{% endif %}
